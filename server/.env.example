# Copy to .env and fill in. .env is git-ignored.
PORT=8787
# Use 0.0.0.0 inside Docker; keep 127.0.0.1 on your laptop.
HOST=127.0.0.1
# The page(s) allowed to call this server (comma separated).
ALLOWED_ORIGIN=https://shaikbasha1437.github.io
# Optional shared secret; paste the same value in the app under Settings > Server.
SERVER_TOKEN=
# Leave true until you have checked the payloads. false = really forward to QuickBooks/Xero.
DRY_RUN=true
# QuickBooks Online (OAuth 2.0 access token from your own Intuit app; expires after about an hour).
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
# Sandbox: https://sandbox-quickbooks.api.intuit.com
QBO_BASE_URL=https://quickbooks.api.intuit.com
# Optional maps from InvoiceClerk names/codes to QuickBooks Ids, as JSON.
QBO_VENDOR_MAP={"Northwind Office Supply":"56"}
QBO_ACCOUNT_MAP={"6000":"7","1400":"89"}
# Xero (OAuth 2.0 access token, expires after 30 minutes; tenant id from the /connections endpoint).
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
